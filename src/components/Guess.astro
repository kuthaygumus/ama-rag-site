---
/** The reader's guess for the day's question, kept in this browser by guess.js. `echo` shows it back later in the day. */
interface Props { echo?: boolean }
const { echo } = Astro.props;
const { t } = Astro.locals;
---
{echo ? (
  <span class="guess-echo" data-guess-echo hidden>{t('rag.guess.echoBefore')}<b data-guess-value></b>{t('rag.guess.echoAfter')}</span>
) : (
  <label class="guess">
    {t('rag.guess.label')} <input type="number" inputmode="numeric" min="0" max="365" data-guess /> {t('rag.guess.unit')}
    <span class="guess-note">{t('rag.guess.note')}</span>
  </label>
)}
